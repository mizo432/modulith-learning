{
  "mcpServers": {
    "excel": {
      "command": "cmd",
      "args": ["/c", "npx", "--yes", "@negokaz/excel-mcp-server"],
      "env": {
        "EXCEL_MCP_PAGING_CELLS_LIMIT": "4000"
      }
    },
    "wsl": {
      "command": "npx",
      "args": ["-y", "mcp-wsl-exec"]
    },
    "word": {
      "command": "npx",
      "args": ["-y", "@knorq/docx-mcp-server"]
    },
    "podman": {
      "command": "npx",
      "args": ["-y", "podman-mcp-server@latest"]
    },
    "orca-security": {
      "command": "npx",
      "args": ["-y", "@orcasecurity/orca-mcp-server@latest"],
      "env": {
        "ORCA_API_TOKEN": "YOUR_ORCA_API_TOKEN"
      }
    },
    "github": {
      "command": "C:\\Users\\hachi\\AppData\\Local\\Microsoft\\WinGet\\Packages\\GitHub.github-mcp-server_Microsoft.Winget.Source_8wekyb3d8bbwe\\github-mcp-server.exe",
      "args": ["stdio"]
    }
  }
}
