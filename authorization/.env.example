# REQ-00019: クライアントID/シークレットの安全な保管
# このファイルは環境変数の例を示しています。
# 実際の値を設定するには、このファイルを .env にコピーして値を変更してください。
# .env ファイルは .gitignore で除外されており、リポジトリにコミットされません。

# OAuth2 クライアント設定
# クライアントID（デフォルト: frontend）
OAUTH2_CLIENT_ID=frontend

# クライアントシークレット（PKCEフローでは不要な場合があります）
OAUTH2_CLIENT_SECRET=

# リダイレクトURI（カンマ区切り）
OAUTH2_CLIENT_REDIRECT_URIS=https://localhost:3000/callback,https://localhost:3000/login/oauth2/code

# ログアウト後のリダイレクトURI（カンマ区切り）
OAUTH2_CLIENT_POST_LOGOUT_REDIRECT_URIS=https://localhost:3000/

# キーストアパスワード（デフォルト: changeit）
# 本番環境では強いパスワードを設定してください
OAUTH2_KEYSTORE_PASSWORD=changeit

# データベース接続情報（デフォルト値が設定されています）
# 本番環境では適切な値を設定してください
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SYSTEM_JDBC_URL=jdbc:postgresql://localhost:5432/postgres
