<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- テスト用コンソール出力 -->
  <appender class="ch.qos.logback.core.ConsoleAppender" name="STDOUT">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Application Loggers -->
  <logger level="debug" name="undecided"/>

  <!-- Hibernate SQLログを出力 -->
  <logger level="debug" name="org.hibernate.SQL"/>
  <logger level="trace" name="org.hibernate.type.descriptor.sql.BasicBinder"/>

  <!-- Spring Boot 関連 -->
  <logger level="info" name="org.springframework"/>

  <!-- Testcontainers 関連 -->
  <logger level="warn" name="org.testcontainers"/>
  <logger level="warn" name="com.github.dockerjava"/>

  <!-- Flyway 関連 -->
  <logger level="info" name="org.flywaydb"/>

  <!-- shared -->
  <logger level="debug" name="com.github.mizo432.shared"/>

  <root level="warn">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
