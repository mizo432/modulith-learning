# Development environment variables
# These variables will be used when running in development mode (npm start)

# API URL for development environment
REACT_APP_API_URL=http://dev-api.example.com/api

# Environment name
REACT_APP_ENV=development

# Theme colors - purple theme for development environment
REACT_APP_PRIMARY_COLOR=#673ab7
REACT_APP_SECONDARY_COLOR=#ff4081
REACT_APP_BACKGROUND_COLOR=#ede7f6
