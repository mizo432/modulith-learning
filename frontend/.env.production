# Production environment variables
# These variables will be used when building for production (npm run build)

# API URL for production environment
REACT_APP_API_URL=https://api.example.com/api

# Environment name
REACT_APP_ENV=production

# Theme colors - indigo theme for production environment
REACT_APP_PRIMARY_COLOR=#3f51b5
REACT_APP_SECONDARY_COLOR=#f50057
REACT_APP_BACKGROUND_COLOR=#e8eaf6
