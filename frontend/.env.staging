# Staging environment variables
# These variables will be used when building for staging

# API URL for staging environment
REACT_APP_API_URL=https://staging-api.example.com/api

# Environment name
REACT_APP_ENV=staging

# Theme colors - orange theme for staging environment
REACT_APP_PRIMARY_COLOR=#ff9800
REACT_APP_SECONDARY_COLOR=#2196f3
REACT_APP_BACKGROUND_COLOR=#fff3e0
